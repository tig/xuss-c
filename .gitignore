# Local caches and host noise (never commit).
.silico/
__pycache__/
.venv/
.pytest_cache/
build/
*.pyc

# ESP-IDF generated config (regenerated by `idf.py set-target`; pin real
# overrides in firmware/sdkconfig.defaults instead).
firmware/sdkconfig
firmware/sdkconfig.old

# Large generated full-song asset (regenerate via firmware/tools/make_song.sh)
firmware/spiffs/*.u8
